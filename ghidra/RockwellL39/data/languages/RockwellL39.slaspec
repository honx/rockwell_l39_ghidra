# SLEIGH specification for the Rockwell C40 / L39 / L3902 modem MCU.
#
# CPU core is the enhanced 6502 used in the R65C19. Compared to stock 6502:
#   * (zp,X) addressing mode at bbb=000 is REPLACED by (zp).
#   * (zp),Y addressing mode at bbb=100 is REPLACED by (zp),X.
#   * Adds 16-bit W register (multiply accumulator) and 16-bit I register
#     (threaded code).
#   * Adds ~43 instructions: arithmetic (MPY/MPA/ADD/ASR/NEG/RND/CLW/LAB),
#     bit ops (RMB/SMB/BBR/BBS, RBA/SBA/BAR/BAS), stack (PSH/PUL/PHW/PLW/
#     PHX/PHY/PLX/PLY/PHI/PLI), threaded (NXT/LII/LAI/LAN/INI/TIP/PIA),
#     control (BRA, JMP (abs,X), JSB0..7, STI, EXC, TAW/TWA).
#
# References:
#   R65C19 Microcomputer Data Sheet, Order No. 410, January 1992 (Rockwell).
#       Appendix A: instruction set, opcode matrix, threaded-code semantics.
#   C40/L39 MCU Technical Reference Manual, doc 1035 (Rockwell).
#       §3.1: memory map; §3.2: CPU registers; §3.5: vectors; Appendix A.

define endian=little;
define alignment=1;

define space RAM      type=ram_space      size=2  default;
define space register type=register_space size=1;

# CPU registers (R65C19 / L3902 — same as 6502 plus W and I).
define register offset=0x00 size=1 [ A X Y P ];
define register offset=0x10 size=2 [ W ];
define register offset=0x10 size=1 [ WL WH ];
define register offset=0x14 size=2 [ I ];
define register offset=0x14 size=1 [ IL IH ];
define register offset=0x20 size=2 [ PC SP ];
define register offset=0x20 size=1 [ PCL PCH S SH ];
# Status-register bits, broken out for SLEIGH.
define register offset=0x30 size=1 [ N V B D Iflag Z C ];

#============================================================
# Tokens
#============================================================
define token opbyte (8)
   op    = (0,7)
   aaa   = (5,7)
   bbb   = (2,4)
   cc    = (0,1)

   # Used for BBR/BBS (column $0F / $8F): action selects R/S, bitindex selects bit.
   action   = (7,7)
   bitindex = (4,6) dec
   optype   = (0,3)
;

define token data8 (8)
   imm8 = (0,7)
   rel  = (0,7) signed
;

define token data16 (16)
   imm16 = (0,15)
;

define token data8b (8)
   imm8b = (0,7)
;

define token data8c (8)
   rel2  = (0,7) signed
;

#============================================================
# Macros
#============================================================
macro pushSR() {
    local ccr:1 = 0xff;
    ccr[7,1] = N;
    ccr[6,1] = V;
    ccr[4,1] = B;
    ccr[3,1] = D;
    ccr[2,1] = Iflag;
    ccr[1,1] = Z;
    ccr[0,1] = C;
    *:1 (SP) = ccr;
    SP = SP - 1;
}

macro popSR() {
    SP = SP + 1;
    local ccr = *:1 SP;
    N = ccr[7,1];
    V = ccr[6,1];
    B = ccr[4,1];
    D = ccr[3,1];
    Iflag = ccr[2,1];
    Z = ccr[1,1];
    C = ccr[0,1];
}

macro resultFlags(value) {
    Z = (value == 0);
    N = (value s< 0);
}

macro subFlags(reg, op, result) {
    local creg = ~reg;
    V = ( ((reg & ~op & ~result) | (creg & op & result)) & 0x80 ) != 0;
    N = (result s< 0);
    Z = (result == 0);
    C = ( ((creg & op) | (op & result) | (result & creg)) & 0x80 ) != 0;
}

macro push1(value) {
    *:1 (SP) = value;
    SP = SP - 1;
}

macro pop1(dest) {
    SP = SP + 1;
    dest = *:1 (SP);
}

macro push2(value) {
    *:2 (SP - 1) = value;
    SP = SP - 2;
}

macro pop2(dest) {
    dest = *:2 (SP + 1);
    SP = SP + 2;
}

#============================================================
# Pseudo-ops (modeled, not fully reversed)
#============================================================
define pcodeop readIRQ;
define pcodeop stop_mode;
define pcodeop idle_mode;
define pcodeop crc_init;
define pcodeop bcd_correct;
define pcodeop multiply_accumulate;
define pcodeop multiply_signed;
define pcodeop round_w;

#============================================================
# Operand resolutions
#============================================================
REL: reloc       is rel       [ reloc = inst_next + rel; ] { export *:2 reloc; }
REL2: reloc      is rel2      [ reloc = inst_next + rel2; ] { export *:2 reloc; }

# OP1 = operand class for cc=01 ALU instructions
#   bbb=0  (zp)         R65C19 zero-page indirect  (was (zp,X) on stock 6502)
#   bbb=1  zp
#   bbb=2  #imm
#   bbb=3  abs
#   bbb=4  (zp),X       R65C19 zp indirect, post-indexed by X (was (zp),Y)
#   bbb=5  zp,X
#   bbb=6  abs,Y
#   bbb=7  abs,X
OP1: (imm8)     is bbb=0; imm8         { addr:2 = imm8; tmp:2 = *:2 addr; export *:1 tmp; }
OP1: imm8       is bbb=1; imm8         { export *:1 imm8; }
OP1: "#"imm8    is bbb=2; imm8         { tmp:1 = imm8; export tmp; }
OP1: imm16      is bbb=3; imm16        { export *:1 imm16; }
OP1: (imm8),X   is bbb=4 & X; imm8     { addr:2 = imm8; tmp:2 = *:2 addr; tmp = tmp + zext(X); export *:1 tmp; }
OP1: imm8,X     is bbb=5 & X; imm8     { tmp:2 = zext(imm8 + X); export *:1 tmp; }
OP1: imm16,Y    is bbb=6 & Y; imm16    { tmp:2 = imm16 + zext(Y); export *:1 tmp; }
OP1: imm16,X    is bbb=7 & X; imm16    { tmp:2 = imm16 + zext(X); export *:1 tmp; }

# OP2 — used for ASL/LSR/ROL/ROR/STX/LDX/STY/LDY/CPX/CPY/INC/DEC/BIT.
OP2: "#"imm8    is bbb=0; imm8         { tmp:1 = imm8; export tmp; }
OP2: imm8       is bbb=1; imm8         { export *:1 imm8; }
OP2: A          is bbb=2 & A           { export A; }
OP2: imm16      is bbb=3; imm16        { export *:1 imm16; }
OP2: imm8,X     is bbb=5 & X; imm8     { tmp:2 = zext(imm8 + X); export *:1 tmp; }
OP2: imm16,X    is bbb=7 & X; imm16    { tmp:2 = imm16 + zext(X); export *:1 tmp; }

OP2ST: OP2      is OP2                 { export OP2; }
OP2ST: imm8,Y   is bbb=5 & Y; imm8     { tmp:2 = zext(imm8 + Y); export *:1 tmp; }

OP2LD: OP2      is OP2                 { export OP2; }
OP2LD: imm8,Y   is bbb=5 & Y; imm8     { tmp:2 = zext(imm8 + Y); export *:1 tmp; }
OP2LD: imm16,Y  is bbb=7 & Y; imm16    { tmp:2 = imm16 + zext(Y); export *:1 tmp; }

ADDR16: imm16   is imm16               { export *:1 imm16; }
ADDRI:  (imm16) is imm16               { tmp:2 = imm16; export *:2 tmp; }
ADDRIX: (imm16,X) is X; imm16          { addr:2 = imm16 + zext(X); tmp:2 = *:2 addr; export tmp; }

#============================================================
# Standard 6502 ALU instructions (cc = 01) — reuse OP1 with R65C19 indirect modes.
#============================================================
:ADC OP1     is (cc=1 & aaa=3) ... & OP1
{
    local op1 = OP1;
    local tmpC = C;
    C = carry(A, op1);
    A = A + op1 + tmpC;
    resultFlags(A);
    V = C;
}

:AND OP1     is (cc=1 & aaa=1) ... & OP1
{
    A = A & OP1;
    resultFlags(A);
}

:CMP OP1     is (cc=1 & aaa=6) ... & OP1
{
    local op1 = OP1;
    local tmp = A - op1;
    resultFlags(tmp);
    C = (A >= op1);
}

:EOR OP1     is (cc=1 & aaa=2) ... & OP1
{
    A = A ^ OP1;
    resultFlags(A);
}

:LDA OP1     is (cc=1 & aaa=5) ... & OP1
{
    A = OP1;
    resultFlags(A);
}

:ORA OP1     is (cc=1 & aaa=0) ... & OP1
{
    A = A | OP1;
    resultFlags(A);
}

:SBC OP1     is (cc=1 & aaa=7) ... & OP1
{
    local op1 = OP1;
    local result = A - op1 - !C;
    subFlags(A, op1, result);
    A = result;
}

:STA OP1     is (cc=1 & aaa=4) ... & OP1
{
    OP1 = A;
}

#============================================================
# Shifts and read/modify/write on memory or accumulator.
#============================================================
:ASL OP2     is (op=0x06 | op=0x0A | op=0x0E | op=0x16 | op=0x1E) ... & OP2
{
    local tmp = OP2;
    C = tmp >> 7;
    tmp = tmp << 1;
    OP2 = tmp;
    resultFlags(tmp);
}

:LSR OP2     is (op=0x46 | op=0x4A | op=0x4E | op=0x56 | op=0x5E) ... & OP2
{
    local tmp = OP2;
    C = tmp & 1;
    tmp = tmp >> 1;
    OP2 = tmp;
    Z = (tmp == 0);
    N = 0;
}

:ROL OP2     is (op=0x26 | op=0x2A | op=0x2E | op=0x36 | op=0x3E) ... & OP2
{
    local tmpC = C;
    local op2 = OP2;
    C = op2 >> 7;
    local result = op2 << 1;
    result = result | tmpC;
    OP2 = result;
    resultFlags(result);
}

:ROR OP2     is (op=0x66 | op=0x6A | op=0x6E | op=0x76 | op=0x7E) ... & OP2
{
    local tmpC = C << 7;
    local tmp = OP2;
    C = tmp & 1;
    tmp = tmp >> 1;
    tmp = tmp | tmpC;
    OP2 = tmp;
    resultFlags(tmp);
}

:INC OP2     is (op=0xE6 | op=0xEE | op=0xF6 | op=0xFE) ... & OP2
{
    local tmp = OP2 + 1;
    OP2 = tmp;
    resultFlags(tmp);
}

:DEC OP2     is (op=0xC6 | op=0xCE | op=0xD6 | op=0xDE) ... & OP2
{
    local tmp = OP2 - 1;
    OP2 = tmp;
    resultFlags(tmp);
}

#============================================================
# Loads / stores / compares for X and Y.
#============================================================
:LDX OP2LD   is (op=0xA2 | op=0xA6 | op=0xAE | op=0xB6 | op=0xBE) ... & OP2LD
{
    X = OP2LD;
    resultFlags(X);
}

:LDY OP2     is (op=0xA0 | op=0xA4 | op=0xAC | op=0xB4 | op=0xBC) ... & OP2
{
    Y = OP2;
    resultFlags(Y);
}

:STX OP2ST   is (op=0x86 | op=0x8E | op=0x96) ... & OP2ST
{
    OP2ST = X;
}

:STY OP2     is (op=0x84 | op=0x8C | op=0x94) ... & OP2
{
    OP2 = Y;
}

:CPX OP2     is (op=0xE0 | op=0xE4 | op=0xEC) ... & OP2
{
    local op1 = OP2;
    local tmp = X - op1;
    resultFlags(tmp);
    C = (X >= op1);
}

:CPY OP2     is (op=0xC0 | op=0xC4 | op=0xCC) ... & OP2
{
    local op1 = OP2;
    local tmp = Y - op1;
    resultFlags(tmp);
    C = (Y >= op1);
}

:BIT OP2     is (op=0x24 | op=0x2C) ... & OP2
{
    N = (OP2 & 0x80) == 0x80;
    V = (OP2 & 0x40) == 0x40;
    local value = A & OP2;
    Z = (value == 0);
}

#============================================================
# Branches and jumps.
#============================================================
:BCC REL     is op=0x90; REL { if (C == 0) goto REL; }
:BCS REL     is op=0xB0; REL { if (C) goto REL; }
:BEQ REL     is op=0xF0; REL { if (Z) goto REL; }
:BMI REL     is op=0x30; REL { if (N) goto REL; }
:BNE REL     is op=0xD0; REL { if (Z == 0) goto REL; }
:BPL REL     is op=0x10; REL { if (N == 0) goto REL; }
:BVC REL     is op=0x50; REL { if (V == 0) goto REL; }
:BVS REL     is op=0x70; REL { if (V) goto REL; }
:BRA REL     is op=0x80; REL { goto REL; }

:JMP ADDR16  is op=0x4C; ADDR16  { goto ADDR16; }
:JMP ADDRI   is op=0x6C; ADDRI   { goto [ADDRI]; }
:JMP ADDRIX  is op=0x7C; ADDRIX  { goto [ADDRIX]; }   # R65C19 addition

:JSR ADDR16  is op=0x20; ADDR16
{
    *:2 (SP - 1) = inst_next;
    SP = SP - 2;
    call ADDR16;
}

# JSB#: hardware-vectored short call. Indirect through $FFE0+2*n.
# The R65C19 datasheet defines opcodes $0B/$1B/$2B/$3B/$4B/$5B/$6B/$7B.
:JSB0  is op=0x0B  { *:2 (SP-1) = inst_next; SP = SP - 2; tgt:2 = *:2 0xFFE0:2; call [tgt]; }
:JSB1  is op=0x1B  { *:2 (SP-1) = inst_next; SP = SP - 2; tgt:2 = *:2 0xFFE2:2; call [tgt]; }
:JSB2  is op=0x2B  { *:2 (SP-1) = inst_next; SP = SP - 2; tgt:2 = *:2 0xFFE4:2; call [tgt]; }
:JSB3  is op=0x3B  { *:2 (SP-1) = inst_next; SP = SP - 2; tgt:2 = *:2 0xFFE6:2; call [tgt]; }
:JSB4  is op=0x4B  { *:2 (SP-1) = inst_next; SP = SP - 2; tgt:2 = *:2 0xFFE8:2; call [tgt]; }
:JSB5  is op=0x5B  { *:2 (SP-1) = inst_next; SP = SP - 2; tgt:2 = *:2 0xFFEA:2; call [tgt]; }
:JSB6  is op=0x6B  { *:2 (SP-1) = inst_next; SP = SP - 2; tgt:2 = *:2 0xFFEC:2; call [tgt]; }
:JSB7  is op=0x7B  { *:2 (SP-1) = inst_next; SP = SP - 2; tgt:2 = *:2 0xFFEE:2; call [tgt]; }

:RTI         is op=0x40
{
    popSR();
    SP = SP + 1;
    local tmp:2 = *:2 SP;
    SP = SP + 1;
    return [tmp];
}

:RTS         is op=0x60
{
    SP = SP + 1;
    local tmp:2 = *:2 SP;
    SP = SP + 1;
    return [tmp];
}

:BRK         is op=0x00
{
    *:2 (SP - 1) = inst_next + 1;
    SP = SP - 2;
    B = 1;
    pushSR();
    Iflag = 1;
    # On L3902 BRK vectors via NMI ($FFFC), not IRQ (TRM §3.5.2).
    local target:2 = *:2 0xFFFC:2;
    goto [target];
}

#============================================================
# Status-register manipulation.
#============================================================
:CLC  is op=0x18 { C = 0; }
:CLD  is op=0xD8 { D = 0; }
:CLI  is op=0x58 { Iflag = 0; }
:CLV  is op=0xB8 { V = 0; }
:SEC  is op=0x38 { C = 1; }
:SED  is op=0xF8 { D = 1; }
:SEI  is op=0x78 { Iflag = 1; }
:NOP  is op=0xEA { }

#============================================================
# Inter-register transfers and stack moves.
#============================================================
:DEX  is op=0xCA { X = X - 1; resultFlags(X); }
:DEY  is op=0x88 { Y = Y - 1; resultFlags(Y); }
:INX  is op=0xE8 { X = X + 1; resultFlags(X); }
:INY  is op=0xC8 { Y = Y + 1; resultFlags(Y); }
:TAX  is op=0xAA { X = A; resultFlags(X); }
:TAY  is op=0xA8 { Y = A; resultFlags(Y); }
:TSX  is op=0xBA { X = S; resultFlags(X); }
:TXA  is op=0x8A { A = X; resultFlags(A); }
:TXS  is op=0x9A { S = X; }
:TYA  is op=0x98 { A = Y; resultFlags(A); }

:PHP  is op=0x08 { pushSR(); }
:PLP  is op=0x28 { popSR(); }
:PHA  is op=0x48 { push1(A); }
:PLA  is op=0x68 { pop1(A); resultFlags(A); }

# 65C02-style PHX/PHY/PLX/PLY (also present on R65C19).
:PHX  is op=0xDA { push1(X); }
:PLX  is op=0xFA { pop1(X); resultFlags(X); }
:PHY  is op=0x5A { push1(Y); }
:PLY  is op=0x7A { pop1(Y); resultFlags(Y); }

#============================================================
# 65C02 bit manipulation (BBR/BBS/RMB/SMB) — present on R65C19.
#============================================================
:RMB bitindex, imm8     is (action=0 & optype=7) & bitindex ; imm8 {
    local ptr:2 = imm8;
    local value:1 = *:1 ptr;
    value = value & ~(1 << bitindex);
    *:1 ptr = value;
}

:SMB bitindex, imm8     is (action=1 & optype=7) & bitindex ; imm8 {
    local ptr:2 = imm8;
    local value:1 = *:1 ptr;
    value = value | (1 << bitindex);
    *:1 ptr = value;
}

:BBR bitindex, imm8, REL is (action=0 & optype=0xF) & bitindex ; imm8 ; REL {
    local ptr:2 = imm8;
    local value:1 = *:1 ptr;
    if ((value & (1 << bitindex)) == 0) goto REL;
}

:BBS bitindex, imm8, REL is (action=1 & optype=0xF) & bitindex ; imm8 ; REL {
    local ptr:2 = imm8;
    local value:1 = *:1 ptr;
    if ((value & (1 << bitindex)) != 0) goto REL;
}

#============================================================
# R65C19 arithmetic / accumulator ops.
#============================================================
# ADD #imm   ($89) : binary add without carry, no flag effect on carry-in.
:ADD "#"imm8   is op=0x89; imm8
{
    local v:1 = imm8;
    A = A + v;
    resultFlags(A);
}

# ASR  ($3A) : arithmetic shift right of A (sign-extending).
:ASR A         is op=0x3A & A
{
    C = A & 1;
    A = A s>> 1;
    resultFlags(A);
}

# NEG  ($1A) : 2's-complement of A.
:NEG A         is op=0x1A & A
{
    A = -A;
    resultFlags(A);
}

# LAB  ($13) : A = abs(A) treated signed.
:LAB A         is op=0x13 & A
{
    if (A s< 0) goto <skip>;
    goto inst_next;
    <skip>
    A = -A;
    resultFlags(A);
}

# CLW  ($43) : clear W and V.
:CLW           is op=0x43
{
    W = 0;
    V = 0;
}

# RND  ($42) : round W; W_high → A; W_low cleared. Modeled as p-code op.
:RND           is op=0x42
{
    round_w();
    A = WH;
    WL = 0;
    resultFlags(A);
}

# TAW / TWA  ($62 / $72) : transfer A↔W (TAW: A→WH, 0→WL; TWA: WH→A).
:TAW           is op=0x62
{
    WH = A;
    WL = 0;
}

:TWA           is op=0x72
{
    A = WH;
    resultFlags(A);
}

# MPY  ($02) : (A * Y) → A,Y signed.
:MPY           is op=0x02
{
    multiply_signed();
}

# MPA  ($12) : (A * Y) + W → A,Y; signed.
:MPA           is op=0x12
{
    multiply_accumulate();
}

# PSH  ($22) : push A,X,Y onto stack.
:PSH           is op=0x22
{
    push1(A);
    push1(X);
    push1(Y);
}

# PUL  ($32) : pull Y,X,A from stack.
:PUL           is op=0x32
{
    pop1(Y);
    pop1(X);
    pop1(A);
}

# PHW  ($23) : push W (high then low).
:PHW           is op=0x23
{
    push1(WH);
    push1(WL);
}

# PLW  ($33) : pull W (low then high).
:PLW           is op=0x33
{
    pop1(WL);
    pop1(WH);
}

# EXC zp,X  ($D4) : exchange A with memory at zp+X.
:EXC imm8,X    is op=0xD4 & X; imm8
{
    local addr:2 = zext(imm8 + X);
    local tmp:1 = *:1 addr;
    *:1 addr = A;
    A = tmp;
    resultFlags(A);
}

# STI  ($B2) : 3 bytes — store immediate to ZP. Encoding: op, imm_value, zp_addr.
:STI "#"imm8b, imm8 is op=0xB2; imm8b; imm8
{
    local addr:2 = imm8;
    *:1 addr = imm8b:1;
}

# RBA / SBA  ($C2 / $D2) : 4 bytes — op, imm16(addr), imm8(mask).
:RBA imm16, "#"imm8b  is op=0xC2; imm16; imm8b
{
    local addr:2 = imm16;
    local mask:1 = imm8b;
    local v:1 = *:1 addr;
    v = v & ~mask;
    *:1 addr = v;
}

:SBA imm16, "#"imm8b  is op=0xD2; imm16; imm8b
{
    local addr:2 = imm16;
    local mask:1 = imm8b;
    local v:1 = *:1 addr;
    v = v | mask;
    *:1 addr = v;
}

# BAR / BAS  ($E2 / $F2) : 5 bytes — op, imm16(addr), imm8(mask), rel.
:BAR imm16, "#"imm8b, REL2  is op=0xE2; imm16; imm8b; REL2
{
    local addr:2 = imm16;
    local mask:1 = imm8b;
    local v:1 = *:1 addr;
    if ((v & mask) == 0) goto REL2;
}

:BAS imm16, "#"imm8b, REL2  is op=0xF2; imm16; imm8b; REL2
{
    local addr:2 = imm16;
    local mask:1 = imm8b;
    local v:1 = *:1 addr;
    if ((v & mask) != 0) goto REL2;
}

#============================================================
# R65C19 threaded-code instructions (use I register).
#============================================================
# NXT  ($8B) : PC = (I); I += 2.
:NXT           is op=0x8B
{
    local tgt:2 = *:2 I;
    I = I + 2;
    goto [tgt];
}

# LII  ($9B) : I = (I).
:LII           is op=0x9B
{
    I = *:2 I;
}

# LAN  ($AB) : A = (I); I += 1.
:LAN           is op=0xAB
{
    A = *:1 I;
    I = I + 1;
    resultFlags(A);
}

# INI  ($BB) : I = I + 1.
:INI           is op=0xBB
{
    I = I + 1;
}

# PHI  ($CB) : push I (high then low).
:PHI           is op=0xCB
{
    push1(IH);
    push1(IL);
}

# PLI  ($DB) : pull I (low then high).
:PLI           is op=0xDB
{
    pop1(IL);
    pop1(IH);
}

# LAI  ($EB) : A = (I); no inc.
:LAI           is op=0xEB
{
    A = *:1 I;
    resultFlags(A);
}

# PIA  ($FB) : pull I, then A = (I), I += 1.
:PIA           is op=0xFB
{
    pop1(IL);
    pop1(IH);
    A = *:1 I;
    I = I + 1;
    resultFlags(A);
}

# TIP  ($03) : PC = I (return-from-threaded-call equivalent of RTS).
:TIP           is op=0x03
{
    return [I];
}
